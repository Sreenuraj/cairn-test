{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn-test.org/schemas/approval.v1.json",
  "title": "cairn-test Approval Schema v1",
  "type": "object",
  "required": ["schema", "subject", "covers", "approver", "at"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "cairn-test.approval/v1"
    },
    "subject": {
      "type": "string"
    },
    "covers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$|^[0-9a-fA-F]{40}$"
      }
    },
    "approver": {
      "type": "object",
      "required": ["name", "key", "key_type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "key": { "type": "string" },
        "key_type": { "type": "string" }
      }
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}
